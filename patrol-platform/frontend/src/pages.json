      },
      {
        "pagePath": "pages/remote/index",
        "text": "控制",
        "iconPath": "static/tab/control.png",
        "selectedIconPath": "static/tab/control-active.png"
      },
      {
        "pagePath": "pages/mecanum/index",
        "text": "麦轮",
        "iconPath": "static/tab/mecanum.png",
        "selectedIconPath": "static/tab/mecanum-active.png"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "static/tab/mine.png",
        "selectedIconPath": "static/tab/mine-active.png"
      }
    ]
  }
}
